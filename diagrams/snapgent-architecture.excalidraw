      "versionNonce": 5551637,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1794641063613,
      "link": null,
      "locked": false,
      "fontSize": 14,
      "fontFamily": 1,
      "text": "Why a sandbox:\n• Only the needed files are copied.\n• The web chat reads that small set.\n• Nothing else is shared.",
      "originalText": "Why a sandbox:\n• Only the needed files are copied.\n• The web chat reads that small set.\n• Nothing else is shared.",
