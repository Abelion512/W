      "link": null,
      "locked": false,
      "fontSize": 14,
      "fontFamily": 1,
      "text": "How to read this:\n• The web chat only writes the answers.\n• It sees a sandbox with only the files it needs.\n• Your main assistant stays in charge.",
      "originalText": "How to read this:\n• The web chat only writes the answers.\n• It sees a sandbox with only the files it needs.\n• Your main assistant stays in charge.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.3,
      "autoResize": true
    },
    {
      "id": "notes2",
      "type": "text",
      "x": 560,
      "y": 980,
      "width": 560,
      "height": 110,
      "angle": 0,
